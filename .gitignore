# 构建产物 / 中间文件
dist/
# ... but helper/dist/ ships the prebuilt LSPosed bridge APK: build-zip.ps1 packages it
# into extras/ and CI needs it in the repo (the directory has to be re-included first,
# git cannot re-include a file whose parent directory is excluded).
# The .prop is generated by the same build and must stay in sync with the APK: it is the
# version the module scripts compare against before reinstalling the bridge.
!helper/dist/
!helper/dist/*.apk
!helper/dist/*.prop
helper/build/
rro/compiled.zip
rro/*.unsigned
rro/*.aligned
*.apk.idsig

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db
